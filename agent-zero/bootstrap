#!/usr/bin/env bash
# agent-zero/bootstrap
# Subcommands: install | verify | status | reset | seed
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
DSN="${DATA_LAYER_POSTGRES_DSN:-postgresql://postgres@localhost:5432/postgres}"
LOCAL_NAME="${DATA_LAYER_LOCAL_CONTAINER_NAME:-__LOCAL_CONTAINER_NAME__}"
log()  { printf '[agent-zero %s] %s\n' "$(date +%H:%M:%S)" "$*"; }
fail() { printf '[agent-zero FAIL] %s\n' "$*" >&2; exit 3; }
usage() { cat <<USAGE
Usage: $0 <install|verify|status|reset|seed>
USAGE
}
seed_one() {
  local file="$1" name="$2"
  [[ -f "$file" ]] || fail "missing $file"
  local tmp; tmp=$(mktemp)
  sed -e "s|__LOCAL_CONTAINER_NAME__|$LOCAL_NAME|g" "$file" > "$tmp"
  psql "$DSN" -v ON_ERROR_STOP=1 -X -tA -f "$tmp" >/dev/null || fail "$name seed failed"
  rm -f "$tmp"
  log "$name applied"
}
case "${1:-help}" in
  install)
    # Note: deps.sh (psycopg + mcp install into /opt/venv-a0) is intentionally
    # NOT called here. In the A0-first compose flow, a0-init populates the
    # shared /opt/venv-a0 volume using the A0 image's own pip (libc-compatible
    # with the A0 runtime that reuses this volume). Calling deps.sh from the
    # adapters image would attempt to execute A0-image-linked binaries from a
    # different glibc base — ELF interpreter not found.
    # The adapters image already ships psycopg[binary] (requirements.txt);
    # wiring only needs plugin copy + seed.
    bash "$ROOT/lib/plugin.sh"
    log "install complete (deps skipped; a0-init owns the shared venv)"
    ;;
  verify)  log "verify: seed integrity check would go here"; exit 0 ;;
  status)  echo "DSN: $DSN"; echo "local container: $LOCAL_NAME"; exit 0 ;;
  reset)   log "reset is a no-op for an agent-zero adapter"; exit 0 ;;
  seed)
    seed_one "$ROOT/seeds/0001_default_agent.sql" "default_agent"
    [[ -n "${DATA_LAYER_RUN_MIGRATE:-}" ]] && seed_one "$ROOT/seeds/0002_migrate_local_id.sql" "migrate_local_id"
    ;;
  help|--help|-h|"") usage ;;
  *) echo "unknown subcommand: $1" >&2; usage >&2; exit 2 ;;
esac
