#!/usr/bin/env bash
# data-layer-adapters/bootstrap
# Subcommands: install | verify | status | reset | seed | help
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
usage() {
  cat <<USAGE
Usage: $0 <subcommand> [args]

Subcommands:
  agent-zero    delegate to data-layer-adapters/agent-zero/bootstrap
  hermes-agent  delegate to data-layer-adapters/hermes-agent/bootstrap
  mcp           install the universal MCP server (data-layer-adapters/mcp)
  all           run install for every framework adapter
  seed          run seed for every framework adapter
  verify|status reset
  help          show this message
USAGE
}
run_in() {
  local dir="$1" sub="$2"
  [[ -x "$ROOT/$dir/bootstrap" ]] || { echo "missing $ROOT/$dir/bootstrap" >&2; return 2; }
  bash "$ROOT/$dir/bootstrap" "$sub"
}
case "${1:-help}" in
  agent-zero)   run_in agent-zero   "${2:-install}" ;;
  hermes-agent) run_in hermes-agent "${2:-install}" ;;
  mcp)
    # MCP server install is framework-agnostic; lives at the adapter collection root.
    [[ -f "$ROOT/mcp/server.py" ]] && echo "[mcp] server.py present; install is framework-level (handled by adapter)" || echo "[mcp] no server.py yet"
    ;;
  all)
    for d in agent-zero hermes-agent; do run_in "$d" install; done
    ;;
  seed)
    for d in agent-zero hermes-agent; do run_in "$d" seed; done
    ;;
  verify)  for d in agent-zero hermes-agent; do run_in "$d" verify;  done ;;
  status)  for d in agent-zero hermes-agent; do run_in "$d" status;  done ;;
  reset)   log="[bootstrap] reset is a no-op for adapter collection"; echo "$log" ;;
  help|--help|-h|"") usage ;;
  *) echo "unknown subcommand: $1" >&2; usage >&2; exit 2 ;;
esac
